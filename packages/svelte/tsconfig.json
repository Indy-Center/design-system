{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["$app/types", "node", "@vitest/browser-playwright"]
  },
  "include": ["src", "test", "*"],
  "exclude": ["src/service-worker"]
}
