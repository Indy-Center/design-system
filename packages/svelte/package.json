{
  "name": "@indy-center/svelte",
  "version": "0.1.0",
  "description": "Indy Centerline's chrome and patterns as Svelte 5 components, styled with Tailwind v4 and @indy-center/tokens.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Indy-Center/design-system.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run build --prefix ../tokens && npm run build && vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@indy-center/tokens": "^0.1.0",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@indy-center/tokens": "^0.1.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  }
}
