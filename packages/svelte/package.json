{
  "name": "@indy-center/centerline-svelte",
  "version": "0.1.0",
  "description": "Indy Centerline's chrome and patterns as Svelte 5 components, styled with Tailwind v4 and @indy-center/centerline-tokens.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Indy-Center/design-system.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "default": "./dist/hooks.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "./.svelte-kit/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite dev",
    "build:playground": "npm run build --prefix ../tokens && vite build",
    "preview:playground": "npm run build:playground && wrangler dev",
    "deploy": "npm run build:playground && wrangler deploy",
    "build": "svelte-kit sync && svelte-package",
    "check": "npm run build --prefix ../tokens && npm run build && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run build --prefix ../tokens && npm run build && vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@indy-center/centerline-tokens": "^0.1.0",
    "@tailwindcss/typography": "^0.5.0",
    "svelte": "^5.20.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/typography": {
      "optional": true
    }
  },
  "devDependencies": {
    "@indy-center/centerline-tokens": "^0.1.0",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "esm-env": "^1.2.2"
  }
}
